{
  "name": "loyanexa",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "postinstall": "prisma generate --schema packages/db/prisma/schema.prisma && node scripts/vendor-jsqr.ts",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "node --test 'packages/*/test/*.test.ts' 'apps/demo/test/*.test.ts'",
    "test:i18n": "node scripts/check-i18n.ts",
    "bench": "node packages/image/bench/strip.bench.ts",
    "serve:pass": "node scripts/serve-pass.ts",
    "demo": "node apps/demo/server.ts",
    "create-merchant": "node scripts/create-merchant.ts",
    "test:css": "node scripts/check-css-literals.ts"
  },
  "devDependencies": {
    "@types/node": "^25",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  }
}

# ---- Apple Wallet ----
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.loyanexa.loyalty
APNS_KEY_ID=
APNS_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
APPLE_SIGNER_CERT_PATH=./certs/signerCert.pem
APPLE_SIGNER_KEY_PATH=./certs/signerKey.pem
APPLE_WWDR_CERT_PATH=./certs/wwdr.pem
APPLE_KEY_PASSPHRASE=

# ---- Google Wallet ----
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_PATH=./certs/service-account.json

# ---- must be HTTPS: Apple silently refuses http and updates never arrive ----
BASE_URL=https://your-ngrok-url.ngrok-free.app

# ---- data ----
DATABASE_URL=postgresql://user:pass@localhost:5432/loyanexa
REDIS_URL=redis://localhost:6379
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loyanexa

# ---- auth & billing ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PORT=3000
NODE_ENV=development

# ---- Apple Wallet ----
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=pass.com.loyanexa.loyalty
APNS_KEY_ID=
APNS_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
APPLE_SIGNER_CERT_PATH=./certs/signerCert.pem
APPLE_SIGNER_KEY_PATH=./certs/signerKey.pem
APPLE_WWDR_CERT_PATH=./certs/wwdr.pem
APPLE_KEY_PASSPHRASE=

# ---- Google Wallet ----
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_PATH=./certs/service-account.json

# ---- Business search in the locations editor (apps/demo/placeSearch.ts) ----
# Optional. Unset, the designer hides the search box and falls back to "use my
# current location" plus the paste-a-Google-Maps-link box, so a checkout with
# no Google Cloud account still edits locations perfectly well.
#
# Needs the Places API (New) and the Geocoding API enabled on a project with
# billing attached. Restrict the key to this server's IP — it is never sent to
# a browser, so a referrer restriction would be the wrong kind — and set a
# daily quota cap in the Cloud console: these are the only calls in this
# codebase that cost money per request, and a cap turns a runaway loop into a
# failed search rather than a bill.
GOOGLE_MAPS_API_KEY=
# Optional ISO-3166-1 country code. Set it and search is RESTRICTED to that
# country ("SA" = Saudi Arabia only); leave it unset and search is worldwide.
#
# Restriction rather than preference is deliberate, and measured: Google's
# softer `regionCode` field barely moves the ranking. Searching "Kudu" — a
# Saudi chain on most high streets — returned Kudus, Indonesia as the top
# three results until the region became an inclusion filter. A merchant who
# cannot find their own shop is not helped by the search being technically
# global.
PLACES_REGION_CODE=

# ---- must be HTTPS: Apple silently refuses http and updates never arrive ----
BASE_URL=https://your-ngrok-url.ngrok-free.app

# ---- data ----
DATABASE_URL=postgresql://user:pass@localhost:5432/loyanexa
REDIS_URL=redis://localhost:6379
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=loyanexa

# ---- auth & billing ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PORT=3000
NODE_ENV=development

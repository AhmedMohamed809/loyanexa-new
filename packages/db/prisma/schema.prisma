generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id          String @id @default(cuid())
  /// Firebase Auth's own user id — unused by the shipped self-contained
  /// session auth (see docs/BUILD.md §2's 2026-08-04 note), kept nullable
  /// and unique so a future Firebase migration can populate it per merchant
  /// without a schema change. Never read or written by apps/demo/auth.ts.
  firebaseUid String? @unique
  email       String @unique
  name        String
  /// scrypt password hash, `scrypt$N$r$p$saltHex$hashHex` (apps/demo/auth.ts's
  /// hashPassword/verifyPassword) — never a plain hash, never a fast one.
  /// Nullable so a Merchant row can exist before a password is set (e.g. the
  /// pre-auth demo row this migration preserves — see its own migration.sql
  /// comment); apps/demo/auth.ts treats a null hash exactly like a wrong
  /// password on sign-in, never as a distinguishable case.
  passwordHash String?
  locale       String    @default("ar")
  plan         Plan      @default(STARTER)
  stripeCustId String?
  subStatus    String    @default("trialing")
  trialEndsAt  DateTime?
  cards        Card[]
  sessions     Session[]
  staff        Staff[]
  broadcastJobs BroadcastJob[]
  createdAt    DateTime  @default(now())

  @@index([firebaseUid])
}

/// A staff PIN account (docs/BUILD.md §8.13: "add staff and give them a PIN
/// to open the stamp screen in a browser — no app"). Scoped to one
/// `Merchant`; a staff account can only ever open the stamp screen
/// (GET /stamp, POST /api/stamp) via a `StaffSession` below, never the
/// merchant's own session-gated routes (/app, /customers, /reports, card
/// editing, settings) — apps/demo/server.ts's requireMerchant() only ever
/// reads the `lnx-session` cookie, never `lnx-staff`, so a staff session is
/// simply invisible to it.
model Staff {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  /// scrypt hash of the 4-6 digit PIN, `scrypt$N$r$p$saltHex$hashHex` — the
  /// exact same encoding and functions (apps/demo/auth.ts's
  /// hashPassword/verifyPassword) as Merchant.passwordHash. Never a plain or
  /// reversibly-encrypted PIN, even though BUILD.md's own job brief is
  /// explicit that a 4-6 digit PIN is "staff convenience, not strong
  /// security" — hashing it costs nothing and a leaked database dump should
  /// never hand out working PINs directly.
  pinHash    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  staffSessions StaffSession[]
  stampEvents   StampEvent[]

  @@index([merchantId])
}

/// Server-side session storage for a staff PIN sign-in — the same pattern as
/// `Session` above (the id itself is the bearer token in the `lnx-staff`
/// cookie), kept as a fully separate table/cookie so a staff session can
/// never be mistaken for a merchant one by any code that only checks "is
/// there a row for this id". Deliberately shorter-lived (see
/// apps/demo/staffAuth.ts's STAFF_SESSION_TTL_MS) than a merchant session —
/// a shared/unattended shop device shouldn't stay signed in indefinitely.
model StaffSession {
  id         String   @id
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// Denormalised from Staff.merchantId — lets getStaffForSession() build
  /// its result without a second query, and gives PIN-attempt rate limiting
  /// a merchant-scoped key without joining through Staff first.
  merchantId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([staffId])
  @@index([expiresAt])
}

/// Server-side session storage (docs/BUILD.md §2's 2026-08-04 note) — `id`
/// itself *is* the opaque random session token (32 random bytes,
/// base64url — apps/demo/auth.ts's createSession), set as the `lnx-session`
/// cookie's value. Deleting a row here is what makes a sign-out or an
/// expiry actually invalidate the session server-side, not just clear the
/// cookie client-side — a stolen/reused cookie value stops working the
/// moment its row is gone.
model Session {
  id         String   @id
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([merchantId])
  @@index([expiresAt])
}

model Card {
  id            String    @id @default(cuid())
  merchantId    String
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  slot          Int
  linkCode      Int       @unique
  linkAlias     String?   @unique
  shortCode     String    @unique
  name          String
  /// The merchant's wordmark — any aspect ratio, shown in the pass header
  /// (logo.png/logo@2x.png) and at the top of the enrol page (BUILD.md
  /// §8.16 point 1, §9). Never used as the stamp graphic — see
  /// `stampSource` below. Renamed from `logoIconUrl`/`logoStampHash`,
  /// whose names conflated "the logo" with "the thing that fills a
  /// stamp" — exactly the design bug this migration fixes: a wordmark
  /// (the owner's real logo is a 1485x302, ~4.9:1 wordmark) fitted into a
  /// circular stamp is illegible at stamp size. docs/BUILD.md §8.9 always
  /// described these as two separate images — "logo · icon 512×512,
  /// required by Google Wallet · cover".
  logoUrl       String?
  logoHash      String?
  /// The merchant's own square-ish mark, used as the filled-stamp graphic
  /// when `stampSource` is `'icon'`. Ideally 512×512 — BUILD.md §8.9 notes
  /// this size is what Google Wallet requires. Never shown in the pass
  /// header; that is `logoUrl` above.
  iconUrl       String?
  iconHash      String?
  /// How `iconUrl`/`iconHash` maps onto the round stamp slot when
  /// `stampSource === 'icon'` — 'contain' (default, whole icon visible,
  /// letterboxed) or 'cover' (fills the circle edge to edge, cropped).
  /// Ignored for 'builtin'/'plain'. Renamed from `logoFit`: the same
  /// Fit/Fill choice, now correctly scoped to the icon — the logo itself
  /// never needs a fit, since it only ever renders at its own aspect
  /// ratio in the pass header / enrol page.
  iconFit       String    @default("contain")
  /// Which artwork fills a *completed* stamp slot (BUILD.md §8.5 step 2's
  /// three-way choice): 'builtin' (a glyph drawn from `builtinIcon`, the
  /// default — a card looks designed with zero uploads), 'icon' (the
  /// merchant's own square upload above), or 'plain' (a solid disc/square,
  /// the original upload-free behaviour). Replaces the old `customStamps`
  /// boolean, which could only express "wordmark-as-stamp or plain disc" —
  /// never "a designed default", and let a wordmark become a stamp at all.
  stampSource   String    @default("builtin")
  /// The built-in icon id (packages/image/src/raster/icons.ts's
  /// BUILTIN_ICON_IDS) drawn when `stampSource === 'builtin'`. Ignored
  /// otherwise.
  builtinIcon   String    @default("star")
  coverUrl      String?
  coverHash     String?
  stampsGoal    Int       @default(8)
  starterStamps Int       @default(0)
  stampShape    String    @default("circle")
  bgColor       String
  /// Opacity (0..1) applied to the strip's composed background — flat colour
  /// and/or cover image alike (StripSpec.bgOpacity in packages/image). Lets a
  /// merchant keep stamps legible over a busy cover photo (BUILD.md §8.5
  /// step 2's opacity slider).
  bgOpacity     Float     @default(1)
  fgColor       String
  stampActive   String
  stampInactive String
  labelStamps   String    @default("")
  labelRewards  String    @default("")
  lang          String    @default("ar")
  expiryType    String    @default("unlimited")
  expiryDays    Int?
  expiryDate    DateTime?
  rewardText    String
  formFields    Json      @default("[\"name\",\"phone\"]")
  locations     Json      @default("[]")
  active        Boolean   @default(false)
  passes        Pass[]
  broadcastJobs BroadcastJob[]
  createdAt     DateTime  @default(now())
  /// Bumped by Prisma on every write to this row — including every
  /// aesthetic card-designer edit (colours, logo, stamp icon, background
  /// image, labels, shape). A built `.pkpass`'s content depends on these
  /// fields just as much as on the owning Pass's own (serial, stamps,
  /// updatedAt) — see apps/demo/pkpassCache.ts's doc comment — so this
  /// column is folded into the `.pkpass` cache key: a design edit changes
  /// it, which changes the key, which makes the next fetch rebuild instead
  /// of serving stale cached bytes to every customer who already holds a
  /// pass for this card.
  updatedAt     DateTime  @updatedAt

  @@unique([merchantId, slot])
  @@index([linkCode])
  @@index([linkAlias])
}

model Pass {
  id           String    @id @default(cuid())
  serial       String    @unique
  shortCode    String    @unique
  cardId       String
  card         Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  merchantId   String
  authToken    String
  custName     String    @default("")
  custEmail    String    @default("")
  custPhone    String    @default("")
  custBirthday DateTime?
  stamps       Int       @default(0)
  totalStamps  Int       @default(0)
  rewards      Int       @default(0)
  message      String    @default("")
  platform     String    @default("")
  lastStampAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  devices      Device[]

  @@index([cardId])
  @@index([merchantId, lastStampAt])
  @@index([updatedAt])
}

model Device {
  deviceId   String
  passSerial String
  pushToken  String
  pass       Pass   @relation(fields: [passSerial], references: [serial], onDelete: Cascade)

  @@id([deviceId, passSerial])
  @@index([passSerial])
}

/// A merchant broadcast (docs/BUILD.md §8.12 / §18 item 6 / §10) — the
/// Postgres-backed job queue that replaces BullMQ-on-Redis for now (see
/// §2's 2026-08-04 note). One row per "send" action: either a merchant
/// tapping Send on the Notifications screen (`kind: "manual"`) or an
/// automated trigger (`kind: "welcome"`, fired from enrolment — see
/// apps/demo/server.ts's handleIssuePass/handleIssueGooglePass;
/// `"birthday"`/`"winback"` are scaffolded in the UI only and no code path
/// ever creates a job with either kind, deliberately — their triggers are
/// not yet scheduled). Created synchronously by apps/demo/broadcast.ts's
/// enqueueBroadcast() — a plain INSERT, so the request handler that calls
/// it still returns immediately; the actual APNs fan-out happens later,
/// entirely inside apps/demo/broadcastWorker.ts's BroadcastWorker, never
/// inside a request handler (BUILD.md §18 item 6).
///
/// `message` is the sanitised, length-capped text a merchant typed (or an
/// automated template produced) — safe to render back into HTML with the
/// usual escapeHtml(), never rendered unescaped. `pushMessage` is the exact
/// string written into every recipient's `Pass.message` column: computed
/// once, at enqueue time, as `message` plus one
/// `invisibleChangeMarker()` (packages/pass/src/buildPass.ts) call —
/// **not** recomputed per recipient or per retry. Fixing it once here is
/// what makes two things true at the same time: (1) a merchant sending the
/// exact same text twice still gets a lock-screen banner both times (two
/// jobs, two markers, two distinct `pushMessage` values), and (2) retrying
/// a single recipient's failed push never re-shows the same banner twice
/// on a device that already received it (every retry writes the *same*
/// `pushMessage` — a no-op diff once the device has already caught up).
model BroadcastJob {
  id             String    @id @default(cuid())
  merchantId     String
  merchant       Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  cardId         String
  card           Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind           String    @default("manual")
  message        String
  pushMessage    String
  /// queued (just enqueued, worker hasn't claimed anything yet) · sending
  /// (at least one recipient claimed) · sent (every recipient reached a
  /// terminal state — sent or failed; see BroadcastRecipient.status).
  /// Never rolled back to an earlier value.
  status         String    @default("queued")
  recipientCount Int
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  recipients     BroadcastRecipient[]

  @@index([merchantId, createdAt])
  @@index([status])
}

/// One target of a BroadcastJob — one row per Pass at the time the job was
/// enqueued (not per Device: a customer with the same pass on two devices
/// is one recipient, matching the "recipient count" the merchant sees
/// before sending). `status`/`attempts`/`nextAttemptAt` are the whole
/// queue: apps/demo/broadcastWorker.ts's BroadcastWorker#claimBatch()
/// claims a batch with a single atomic
/// `UPDATE ... FROM (SELECT ... FOR UPDATE SKIP LOCKED) ...` statement —
/// the standard Postgres job-queue idiom — which is what lets two worker
/// processes run against the same table without ever claiming the same
/// row: Postgres itself arbitrates. `claimedAt` also recovers a row a
/// worker claimed but never finished (e.g. the process was killed
/// mid-send): claimBatch() re-claims any `"sending"` row whose
/// `claimedAt` is older than its `staleClaimMs` option, so a crash never
/// strands a recipient forever — see BroadcastWorker's own doc comment for
/// why this cannot be made a *perfect* exactly-once guarantee against a
/// non-transactional external API (APNs), only a safe, self-healing one.
model BroadcastRecipient {
  id            String       @id @default(cuid())
  jobId         String
  job           BroadcastJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  passSerial    String
  /// pending (waiting to be claimed, or waiting out a backoff —
  /// `nextAttemptAt`) · sending (claimed by a worker right now) · sent ·
  /// failed (attempts exhausted BroadcastWorker's maxAttempts).
  status        String       @default("pending")
  attempts      Int          @default(0)
  lastError     String?
  /// @db.Timestamptz, deliberately, unlike every other DateTime column in
  /// this schema: these two are compared against a JS `Date` parameter
  /// inside apps/demo/broadcastWorker.ts's raw `$queryRaw` claim query
  /// (`SELECT … FOR UPDATE SKIP LOCKED`, needed because Prisma's own query
  /// builder cannot express that clause). node-postgres serialises an
  /// outgoing `Date` parameter for a plain `timestamp` (no time zone)
  /// column using its *local* wall-clock reading with the zone offset
  /// attached — and Postgres, per its own documented behaviour, silently
  /// discards that offset for a `timestamp` (not `timestamptz`) target.
  /// On a server whose local zone isn't UTC (BST, UTC+1, is what surfaced
  /// this — see apps/demo/test/broadcastWorker.test.ts's backoff test),
  /// that combination systematically stores the wrong instant: a value
  /// written this way and read back through Prisma's own typed API (which
  /// treats naive timestamps as UTC, consistently, both ways) comes back
  /// shifted by the server's UTC offset. `timestamptz` carries the offset
  /// through to Postgres instead of losing it, so both write paths — raw
  /// SQL and Prisma's typed client — agree on the same absolute instant
  /// regardless of the machine's local timezone. Every other DateTime
  /// column in this schema is only ever read/written through Prisma's own
  /// typed API, so this correction is scoped to just the two columns that
  /// actually go through a raw SQL parameter.
  claimedAt     DateTime? @db.Timestamptz(3)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt

  @@unique([jobId, passSerial])
  @@index([status, nextAttemptAt])
  @@index([jobId, status])
}

/// Content-addressed image storage for card logos/covers — interim home for
/// upload bytes until R2 is wired up (docs/BUILD.md §18 item 2: "leaving
/// logos in the database" is risk #2, because rows reach megabytes and are
/// read on every query). Keying by `hash` (the sha256 of the *normalised*
/// PNG bytes, computed by @loyanexa/image's `imageHash`) means an image
/// lives here exactly once regardless of how many cards use it, `Card`
/// itself stores only the hash (logoStampHash/coverHash), and the row is
/// never read as part of an ordinary Card query — only by `GET /img/:hash`,
/// which can cache it forever because the key can never point at different
/// bytes. When R2 replaces this (see docs/DEPLOY.md), this table drops in
/// favour of an object-storage key and `bytes` goes away; nothing else in
/// the schema should need to change, since every consumer already only
/// knows the hash.
model CardImage {
  hash      String   @id
  bytes     Bytes
  width     Int
  height    Int
  mime      String
  createdAt DateTime @default(now())
}

model StampEvent {
  id         BigInt    @id @default(autoincrement())
  merchantId String
  cardId     String
  serial     String
  kind       EventKind
  source     String    @default("browser")
  /// Which staff member recorded this stamp, when the stamp screen was
  /// opened with a staff PIN — null when the merchant themself was signed
  /// in (BUILD.md §8.13's fraud story: "who did what"). `onDelete: SetNull`
  /// so removing a staff account never rewrites or deletes their stamp
  /// history, just detaches the name from it.
  staffId    String?
  staff      Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  at         DateTime  @default(now())

  @@index([merchantId, at])
  @@index([cardId, kind])
  @@index([staffId])
}

model LinkCounter {
  id    Int @id @default(1)
  value Int @default(10000)
}

enum Plan {
  STARTER
  GROWTH
  PRO
}

enum EventKind {
  ENROLL
  STAMP
  REWARD
  REDEEM
}
